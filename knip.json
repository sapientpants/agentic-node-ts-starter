{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/index.ts!", "src/dev/**/*.ts!", "tests/**/*.spec.ts"],
  "project": ["src/**/*.ts!", "tests/**/*.ts"],
  "ignore": ["src/**/*.example.ts", "tests/**/*.template.ts"],
  "ignoreDependencies": ["pino-roll", "pino-syslog", "pino-pretty", "@fast-check/vitest"],
  "ignoreBinaries": ["dot"],
  "ignoreExportsUsedInFile": true
}
